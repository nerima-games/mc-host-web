{
  "name": "@nerima-games/mc-host-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Browser host runtime for the nerima-games Minecraft clone.",
  "homepage": "https://github.com/nerima-games/mc-host-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nerima-games/mc-host-web.git"
  },
  "bugs": {
    "url": "https://github.com/nerima-games/mc-host-web/issues"
  },
  "author": "takeokunn",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.24.0"
  },
  "packageManager": "pnpm@12.14.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "keywords": [
    "minecraft",
    "effect-ts",
    "typescript",
    "browser",
    "host"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --pretty false && tsc -p tsconfig.test.json --pretty false && tsc -p tsconfig.preview.json --pretty false",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.release.json --pretty false",
    "dev": "vite",
    "build:web": "vite build",
    "lint": "oxlint --deny-warnings src scripts/clean-dist.mjs scripts/verify-package.mjs && oxlint --deny-warnings --config .oxlintrc.migrated.json apps e2e test scripts/verify-development-pages.mjs && ast-grep scan",
    "lint:fix": "oxlint --fix src scripts/clean-dist.mjs scripts/verify-package.mjs && oxlint --fix --config .oxlintrc.migrated.json apps e2e test scripts/verify-development-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "package:verify": "pnpm build && pnpm build:web && node scripts/verify-development-pages.mjs && node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm verify && pnpm package:verify",
    "e2e:browser": "playwright test"
  },
  "dependencies": {
    "@nerima-games/mc-audio": "0.2.8",
    "@nerima-games/mc-compose": "0.2.13",
    "@nerima-games/mc-kernel": "0.7.1",
    "@nerima-games/mc-physics": "0.2.2",
    "@nerima-games/mc-render": "0.7.0",
    "@nerima-games/mc-save": "0.4.2",
    "@nerima-games/mc-server": "0.1.0",
    "@nerima-games/mc-sim": "0.4.2",
    "@nerima-games/mc-worldgen": "0.3.2",
    "@nerima-games/mx-gameplay": "0.6.0",
    "@nerima-games/mx-multiplayer": "0.11.0",
    "@nerima-games/mx-redstone": "0.3.3",
    "@nerima-games/mx-ui": "0.5.4",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/vitest": "0.30.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "4.1.11",
    "three": "0.186.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.11",
    "ws": "8.22.0"
  }
}
