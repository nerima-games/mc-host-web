{
  "$schema": "https://oxc-project.github.io/oxc/schema/linter.json",
  "env": {
    "es2022": true,
    "browser": true,
    "node": true
  },
  "settings": {
    "typescript": {
      "version": "7.0"
    }
  },
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "perf": "warn",
    "style": "warn",
    "restriction": "warn"
  },
  "rules": {
    "@typescript-eslint/consistent-type-definitions": ["warn", "type"],
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-unused-vars": "warn",
    "@typescript-eslint/no-floating-promises": "warn",
    "no-console": "warn",
    "no-debugger": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-await-in-loop": "warn",
    "no-promise-executor-return": "warn",
    "no-redeclare": "warn",
    "no-shadow": "warn",
    "no-unused-private-class-members": "warn",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "effect",
            "message": "Use named imports from the effect package.",
            "importNames": ["default"]
          }
        ]
      }
    ]
  },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "dist/**",
    ".git/**",
    "*.config.ts",
    "docs/**"
  ]
}
